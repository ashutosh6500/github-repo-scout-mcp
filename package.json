{
  "name": "github-repo-scout-mcp",
  "version": "0.3.2",
  "description": "Read-only MCP server for discovering and evaluating GitHub repositories: multi-topic search, repo health scores, comparisons, dependency vulnerability audits and supply chain risk checks. Works without a token.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "github-repo-scout-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prepublishOnly": "npm run build && node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "github",
    "github-search",
    "repository",
    "topics",
    "repo-health",
    "claude",
    "ai-agent",
    "security",
    "vulnerabilities",
    "supply-chain",
    "dependency-audit",
    "openssf-scorecard"
  ],
  "author": "Ashutosh Kodavade",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashutosh6500/github-repo-scout-mcp.git"
  },
  "homepage": "https://github.com/ashutosh6500/github-repo-scout-mcp#readme",
  "bugs": {
    "url": "https://github.com/ashutosh6500/github-repo-scout-mcp/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ashutosh6500"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
